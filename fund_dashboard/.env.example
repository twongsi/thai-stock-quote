# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าของตัวเอง
#   cp .env.example .env

# API Key จาก https://secopendata.sec.or.th/  (สมัคร -> subscribe product กลุ่ม Fund -> คัดลอก key)
SEC_API_KEY=

# จำนวนปีของ NAV ย้อนหลังที่จะดึง (ค่าเริ่มต้น 5, ใส่ 20 ถ้าอยากได้ตั้งแต่จัดตั้งกองทุน — ดึงช้าลง)
SEC_HISTORY_YEARS=5

# อัตราผลตอบแทนปราศจากความเสี่ยงต่อปี ใช้คำนวณ Sharpe / Sortino (0.02 = 2%)
RISK_FREE_RATE=0.02

# โฟลเดอร์เก็บ cache (ค่าเริ่มต้น fund_dashboard/cache)
# SEC_CACHE_DIR=
